# ============================================================
# Sentient HRIS — Environment Variables Template
# ============================================================
# Copy this file to .env in each service directory and fill in values.
# Root .env is NOT loaded by services — each service loads its own .env.
# DO NOT commit real .env files. This .env.example IS committed.
# ============================================================

# ── Shared / Cross-Service ──────────────────────────────────────────────────
# Used by all 3 NestJS services for JWT signing/validation.
# MUST be identical in all services for tokens to validate cross-service.
JWT_SECRET=change-me-in-production-minimum-32-random-characters
JWT_EXPIRY=15m

# System-role JWTs (minted by AI Agentic for scheduled/push tasks)
SYSTEM_JWT_SECRET=change-me-system-secret-minimum-32-random-characters
SYSTEM_JWT_EXPIRY=5m

# ── OpenAI (AI Agentic service, Month 4+) ──────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Docker Database (root .env) ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=sentient

# ── HR Core Service (apps/hr-core/.env) ────────────────────────────────────
HR_CORE_DATABASE_URL=postgresql://hr_core_svc:hr_core_pass@localhost:5432/sentient?schema=hr_core
HR_CORE_PORT=3001
FRONTEND_URL=http://localhost:3000

# IAM — refresh token lifetime
REFRESH_TOKEN_EXPIRY_DAYS=7

# IAM — password policy
PASSWORD_HISTORY_DEPTH=5

# IAM — lockout policy
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15

# IAM — Argon2id hashing (calibrate ARGON2_MEMORY_COST so hashing ≈ 200ms on target hardware)
# In tests set TEST_ARGON2_FAST=true to use fast params (memory=4096, time=1)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Channel identities — Telegram/Slack pairing codes (Settings > Linked Channels)
CHANNEL_LINK_CODE_EXPIRY_MINUTES=10

# AI Agentic — HR Core calls this after a leave decision to push a Telegram
# DM to the requester (best-effort; failures are logged, never surfaced).
AI_AGENTIC_URL=http://localhost:3003

# IAM — user onboarding invite emails
# Leave SMTP_HOST empty to fall back to console logging (stdout) — useful in dev.
# For local dev with Mailpit (docker compose up mailpit → UI at http://localhost:8025):
#   SMTP_HOST=localhost  SMTP_PORT=1025  (no SMTP_USER / SMTP_PASS needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sentient.dev
INVITE_TOKEN_EXPIRY_HOURS=72

# ── Social Service (apps/social/.env) ──────────────────────────────────────
SOCIAL_DATABASE_URL=postgresql://social_svc:social_pass@localhost:5432/sentient?schema=social
SOCIAL_PORT=3002
# HR_CORE_URL is used by Social to call HR Core for employee data
HR_CORE_URL=http://localhost:3001
# In-process employee-ref cache TTL (milliseconds). Default: 60000 (1 minute).
HR_CORE_EMPLOYEE_CACHE_TTL_MS=60000

# ── AI Agentic Service (apps/ai-agentic/.env) ──────────────────────────────
AI_AGENT_DATABASE_URL=postgresql://ai_agent_svc:ai_pass@localhost:5432/sentient?schema=ai_agent
# Read-only analytics connection (ai_analytics_readonly role, hr_core schema)
AI_ANALYTICS_DATABASE_URL=postgresql://ai_analytics_readonly:readonly_pass@localhost:5432/sentient?schema=hr_core
AI_AGENT_PORT=3003
# AI Agentic calls both HR Core and Social
# HR_CORE_URL=http://localhost:3001  (same as above)
SOCIAL_URL=http://localhost:3002

# Telegram channel. Get a token from @BotFather on Telegram.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# TELEGRAM_MODE=polling (default) needs no public URL — long polling via
# grammY. Disabled by default so hot-reload in dev doesn't fight a second
# poller instance (Telegram allows only one getUpdates poller per bot token
# — a second one gets HTTP 409).
#
# TELEGRAM_MODE=webhook requires a public HTTPS URL Telegram can reach —
# this repo's docker-compose only exposes localhost, so in dev that means a
# tunnel (`ngrok http 3013` or `cloudflared tunnel --url http://localhost:3013`);
# in production, a real domain in front of AI Agentic. Point
# TELEGRAM_WEBHOOK_URL at <that URL>/channels/telegram/webhook. A tunnel's
# URL changes every restart — setWebhook re-runs on every boot (onModuleInit),
# so just update the env var and restart. TELEGRAM_WEBHOOK_SECRET is any
# random string of your choosing; grammY sends it back on every delivery via
# the X-Telegram-Bot-Api-Secret-Token header, and TelegramController checks
# it — it is the ONLY auth on that endpoint, so treat it like a credential.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── API Gateway Service (apps/api-gateway/.env) ────────────────────────────
API_GATEWAY_PORT=3004
API_GATEWAY_CORS_ORIGINS=http://localhost:3000
API_GATEWAY_TRUST_PROXY=false
API_GATEWAY_JWT_SECRET=change-me-in-production-minimum-32-random-characters
API_GATEWAY_UPSTREAM_TIMEOUT_MS=15000
API_GATEWAY_DEFAULT_JSON_BODY_LIMIT_BYTES=10485760
API_GATEWAY_UPLOAD_BODY_LIMIT_BYTES=52428800
API_GATEWAY_AUTH_RATE_LIMIT_WINDOW_MS=60000
API_GATEWAY_AUTH_RATE_LIMIT_MAX=120
API_GATEWAY_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
API_GATEWAY_PUBLIC_RATE_LIMIT_MAX=30
AI_AGENTIC_URL=http://localhost:3003

# ── Exit Survey & Scoped Tokens (Social service, Month 3+) ─────────────────
SURVEY_TOKEN_SECRET=change-me-survey-token-secret-minimum-32-chars
SURVEY_TOKEN_EXPIRY_DAYS=14

# ── Notification Channels (Month 4+) ───────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Middleware / Rate Limiting / Timeouts ──────────────────────────────────
# ThrottlerModule: requests allowed per IP per window (applies to all 3 services)
# TTL is in milliseconds — 60000 = 1 minute
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Route handler timeout in milliseconds (default 30s for hr-core and social)
# For ai-agentic, set to 60000 — LLM agent chains can take 15-45s
REQUEST_TIMEOUT_MS=30000

# ── Vite Frontend (apps/web/.env.local) ────────────────────────────────────
# Leave blank in local dev to use the Vite /api proxy, or set an absolute gateway URL.
VITE_API_GATEWAY_URL=
