<mxfile host="app.diagrams.net" type="device"><diagram id="bot-link-seq" name="Bot account linking"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="Sentient - Linking a Slack / Telegram account to the Sentient bot (code-based pairing)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="-30" width="1300" height="30" as="geometry"/></mxCell><mxCell id="f2" value="Telegram follows the same flow: TelegramService (grammY, long polling or webhook) handles `/link &lt;code&gt;`,&#10;externalId = Telegram chatId, replies via sendMessage. Codes are single-use, stored hashed, 10-minute expiry&#10;(CHANNEL_LINK_CODE_EXPIRY_MINUTES)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="-95" width="560" height="58" as="geometry"/></mxCell><mxCell id="f3" value="Phase 1 - Get a link code from the web app" style="shape=umlFrame;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingLeft=6;width=292;height=24;fillColor=#e1d5e7;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="1475.0" height="500" as="geometry"/></mxCell><mxCell id="f4" value="Phase 2 - First message from an unlinked Slack account" style="shape=umlFrame;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingLeft=6;width=364;height=24;fillColor=#e1d5e7;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1475.0" height="590" as="geometry"/></mxCell><mxCell id="f5" value="alt  [count = 1]" style="shape=umlFrame;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingLeft=6;width=136;height=24;fillColor=#FFFFFF;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="1670" width="1435.0" height="440" as="geometry"/></mxCell><mxCell id="f6" value="Phase 3 - Redeem the code in Slack" style="shape=umlFrame;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingLeft=6;width=244;height=24;fillColor=#e1d5e7;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1300" width="1475.0" height="830" as="geometry"/></mxCell><mxCell id="f7" value="Phase 4 - After linking: user is recognised on every message" style="shape=umlFrame;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingLeft=6;width=400;height=24;fillColor=#e1d5e7;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="2160" width="1475.0" height="328" as="geometry"/></mxCell><mxCell id="Luser" value="Employee" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="60" width="30" height="50" as="geometry"/></mxCell><mxCell id="Luserline" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="130" as="sourcePoint"/><mxPoint x="60" y="2518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="Lchat" value="Slack / Telegram" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="155.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="Lweb" value="Web App (React)&#10;My Profile &gt; Linked Channels" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="355.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="Lgw" value="API Gateway&#10;:3004" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="555.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="Lai" value="AI Agentic :3003&#10;SlackService / TelegramService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="785.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="Lhr" value="HR Core :3001&#10;ChannelIdentitiesController/Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1035.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="Ldb" value="PostgreSQL hr_core&#10;channel_link_codes / channel_identities" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1295.0" y="70" width="190" height="2448" as="geometry"/></mxCell><mxCell id="c2" value="1: Open My Profile &gt; Linked Channels, click Connect (Slack)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="190" as="sourcePoint"/><mxPoint x="450" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value=