e;fontSize=10;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1162" y="374" width="330" height="42" as="geometry"/></mxCell><mxCell id="c9" value="6: deleteMany ChannelLinkCode(userId, SLACK, consumedAt = null)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="436" as="sourcePoint"/><mxPoint x="1390" y="436" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="7: create ChannelLinkCode(userId, SLACK, codeHash, expiresAt = now + 10 min)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="482" as="sourcePoint"/><mxPoint x="1390" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="8: 201 {code: &quot;937615&quot;, expiresAt}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="528" as="sourcePoint"/><mxPoint x="650" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="9: 201 {code, expiresAt}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="574" as="sourcePoint"/><mxPoint x="450" y="574" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="10: Dialog: send `link 937615` to the bot (expires in 10 min)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="620" as="sourcePoint"/><mxPoint x="60" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="11: DM to Sentient bot: &quot;hi&quot;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="720" as="sourcePoint"/><mxPoint x="250" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="12: message.im event (Socket Mode WS, or POST /channels/slack/events)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="766" as="sourcePoint"/><mxPoint x="880" y="766" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;verticalAlign=middle;align=left;endArrow=block;endFill=1;fontSize=10;rounded=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="812" as="sourcePoint"/><mxPoint x="880" y="846" as="targetPoint"/><Array as="points"><mxPoint x="908" y="812"/><mxPoint x="908" y="846"/></Array></mxGeometry></mxCell><mxCell id="c17" value="13: [events mode] verify X-Slack-Signature HMAC, ack; skip bot's own messages&#10;&quot;hi&quot; is not a command -&gt; onText(): claim in-flight lock" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="912" y="808" width="330" height="42" as="geometry"/></mxCell><mxCell id="c18" value="14: chat.postMessage &quot;_Thinking..._&quot; (placeholder)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="870" as="sourcePoint"/><mxPoint x="250" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="" style="html=1;verticalAlign=middle;align=left;endArrow=block;endFill=1;fontSize=10;rounded=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="916" as="sourcePoint"/><mxPoint x="880" y="942" as="targetPoint"/><Array as="points"><mxPoint x="908" y="916"/><mxPoint x="908" y="942"/></Array></mxGeometry></mxCell><mxCell id="c20" value="15: resolveSession(U...): sessionCache miss" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="912" y="912" width="330" height="34" as="geometry"/></mxCell><mxCell id="c21" value="16: POST /channel-identities/exchange {SLACK, externalId: U...}  [SYSTEM JWT, task channel_token_exchange]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="966" as="sourcePoint"/><mxPoint x="1130" y="966" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="17: findUnique ChannelIdentity(channel, externalId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1012" as="sourcePoint"/><mxPoint x="1390" y="1012" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="18: null" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1390" y="1058" as="sourcePoint"/><mxPoint x="1130" y="1058" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="19: 404 This chat is not linked to a Sentient account yet" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1104" as="sourcePoint"/><mxPoint x="880" y="1104" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="20: chat.update placeholder -&gt; unlinked message (LINK_HINT)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="1150" as="sourcePoint"/><mxPoint x="250" y="1150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="21: Bot reply" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="1196" as="sourcePoint"/><mxPoint x="60" y="1196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="Sentient bot: This Slack account isn't linked to a Sentient account yet.&#10;Get a link code from My Profile &gt; Linked Channels in the web app,&#10;then send me `link &lt;code&gt;` here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="72" y="1204" width="420" height="52" as="geometry"/></mxCell><mxCell id="c28" value="22: DM: &quot;link 937615&quot;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1340" as="sourcePoint"/><mxPoint x="250" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="23: message.im event" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="1386" as="sourcePoint"/><mxPoint x="880" y="1386" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="" style="html=1;verticalAlign=middle;align=left;endArrow=block;endFill=1;fontSize=10;rounded=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="1432" as="sourcePoint"/><mxPoint x="880" y="1458" as="targetPoint"/><Array as="points"><mxPoint x="908" y="1432"/><mxPoint x="908" y="1458"/></Array></mxGeometry></mxCell><mxCell id="c31" value="24: handleDirectMessage(): command = link, argument = 937615" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="912" y="1428" width="330" height="34" as="geometry"/></mxCell><mxCell id="c32" value="25: POST /channel-identities/redeem-link-code {SLACK, externalId: U..., code}  [SYSTEM JWT, task channel_link]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="1482" as="sourcePoint"/><mxPoint x="1130" y="1482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;verticalAlign=middle;align=left;endArrow=block;endFill=1;fontSize=10;rounded=0;spacingLeft=4;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1528" as="sourcePoint"/><mxPoint x="1130" y="1554" as="targetPoint"/><Array as="points"><mxPoint x="1158" y="1528"/><mxPoint x="1158" y="1554"/></Array></mxGeometry></mxCell><mxCell id="c34" value="26: @Throttle 20/min; codeHash = hash(code); open $transaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1162" y="1524" width="330" height="34" as="geometry"/></mxCell><mxCell id="c35" value="27: updateMany ChannelLinkCode SET consumedAt = now WHERE codeHash, SLACK, not consumed, not expired" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1578" as="sourcePoint"/><mxPoint x="1390" y="1578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="28: count" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSi