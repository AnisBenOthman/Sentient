        <mxCell id="nt0" value="Les trois operations partagent une connexion dediee : sur un pool partage, les variables de session et la requete tomberaient sur des connexions distinctes et tout le perimetrage serait silencieusement annule." style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#fffbe6;strokeColor=#d6ba57;align=left;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1420" y="632" width="300" height="96" as="geometry"/></mxCell>
